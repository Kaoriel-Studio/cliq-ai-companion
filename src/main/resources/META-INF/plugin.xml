<idea-plugin>
    <id>com.cliq.plugin</id>
    <name>Cliq AI Companion</name>
    <vendor email="sagem3455@gmail.com">Cliq</vendor>

    <description><![CDATA[
        Cliq is a graphical companion for the Claude and Gemini command-line agents.
        It exposes a tool window, a configurable launcher, and a settings page that
        lets you specify which CLI binary to run for each agent. The plugin shells
        out to the configured executables inside the IDE's integrated terminal so
        you keep one workflow for editing and chatting.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends optional="true" config-file="cliq-vcs.xml">com.intellij.modules.vcs</depends>
    <depends optional="true" config-file="cliq-git.xml">Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
            parentId="tools"
            id="com.cliq.plugin.settings.CliqSettingsConfigurable"
            instance="com.cliq.plugin.settings.CliqSettingsConfigurable"
            displayName="Cliq"/>

        <projectConfigurable
            parentId="com.cliq.plugin.settings.CliqSettingsConfigurable"
            id="com.cliq.plugin.review.settings.CliqReviewConfigurable"
            instance="com.cliq.plugin.review.settings.CliqReviewConfigurable"
            displayName="Code Review"/>

        <notificationGroup id="Cliq" displayType="BALLOON"/>

        <toolWindow
            id="Cliq"
            anchor="right"
            icon="/icons/cliq.svg"
            factoryClass="com.cliq.plugin.toolwindow.CliqToolWindowFactory"/>

        <postStartupActivity implementation="com.cliq.plugin.startup.CliqStartupActivity"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <localTerminalCustomizer implementation="com.cliq.plugin.terminal.CliqTerminalEnvCustomizer"/>
    </extensions>

    <actions>
        <action
            id="com.cliq.plugin.RunAgent"
            class="com.cliq.plugin.actions.CliqAgentAction"
            text="Run Cliq Agent"
            description="Pick a configured Claude or Gemini CLI and launch it in the integrated terminal"
            icon="/icons/cliq.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt Q"/>
        </action>

        <action
            id="com.cliq.plugin.OpenSettings"
            class="com.cliq.plugin.settings.OpenCliqSettingsAction"
            text="Cliq Settings"
            description="Open the Cliq settings page">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="com.cliq.plugin.RunAgent"/>
        </action>

        <action
            id="com.cliq.plugin.ProposeDemoDiff"
            class="com.cliq.plugin.actions.ProposeDemoDiffAction"
            text="Cliq: Propose Demo Diff for Current File"
            description="Open a Cliq review against the focused file (development helper)"
            internal="true">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="com.cliq.plugin.OpenSettings"/>
        </action>

        <action
            id="com.cliq.plugin.AcceptDiff"
            class="com.cliq.plugin.diff.AcceptCliqDiffAction"
            text="Accept All Changes"
            description="Apply all of Cliq's proposed changes to the file">
            <keyboard-shortcut keymap="$default" first-keystroke="alt ENTER"/>
        </action>
        <action
            id="com.cliq.plugin.RejectDiff"
            class="com.cliq.plugin.diff.RejectCliqDiffAction"
            text="Reject All Changes"
            description="Discard all of Cliq's proposed changes and close the review">
            <keyboard-shortcut keymap="$default" first-keystroke="alt BACK_SPACE"/>
        </action>

        <action
            id="com.cliq.plugin.CollectReviewContext"
            class="com.cliq.plugin.review.ui.CollectReviewContextAction"
            text="Cliq: Collect Pull/Merge Request Context…"
            description="Collect the diffs, files, CI status and discussions of a GitHub pull request or GitLab merge request and attach them to the Cliq context for review"
            icon="AllIcons.Vcs.Merge">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="com.cliq.plugin.OpenSettings"/>
        </action>

        <action
            id="com.cliq.plugin.InsertFilesAsContext"
            class="com.cliq.plugin.actions.InsertFilesAsContextAction"
            text="Cliq: Send Files as @-Context to Terminal"
            description="Inserts @relative/path tokens for the selected files into the active terminal session">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
